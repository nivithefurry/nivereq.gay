{
  "name": "nivereq-art-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.16.0" },
  "scripts": {
    "init": "node manage.mjs init",
    "import": "node manage.mjs import",
    "export": "node manage.mjs export",
    "backup": "node manage.mjs backup",
    "restore": "node manage.mjs restore",
    "start": "node manage.mjs serve",
    "dev": "nodemon --watch manage.mjs --watch manager.html --ext mjs,html manage.mjs serve",
    "test": "node --test"
  },
  "devDependencies": { "nodemon": "^3.1.14" }
}
